{
  "name": "ssh-clipboard-desktop-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build": "npm run check && vite build",
    "tauri": "tauri",
    "build:prototype": "node scripts/build-prototype.mjs",
    "build:installed": "node scripts/build-installed.mjs",
    "test:package": "node scripts/smoke-installed-build.mjs",
    "test": "node --test tests/*.test.mjs && vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.2",
    "@testing-library/svelte": "^5.4.2",
    "jsdom": "^30.1.2",
    "svelte-check": "4.7.6",
    "typescript": "^6.0.0",
    "vite": "8.3.4",
    "vitest": "^5.0.4"
  }
}
