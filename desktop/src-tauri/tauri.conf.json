{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSH Clipboard Prototype",
  "version": "0.0.0",
  "identifier": "io.github.johansigfrids.sshclipboard.prototype",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "SSH Clipboard",
      "width": 440,
      "height": 670,
      "minWidth": 340,
      "minHeight": 440,
      "center": true
    }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../assets/icon.png", "../../assets/icon.ico"]
  }
}
